rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function me() {
      return get(/databases/$(database)/documents/moradores/$(request.auth.uid)).data;
    }
    function approved() {
      return signedIn()
        && exists(/databases/$(database)/documents/moradores/$(request.auth.uid))
        && me().aprovado == true;
    }
    function ownsAp(ap) { return approved() && me().ap == ap; }

    // Distribuição das vagas: pública para leitura, só admin altera
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lista de administradores: criada à mão no console do Firebase
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Pedido de acesso de cada conta Google (um por pessoa)
    match /moradores/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['ap', 'nome', 'email', 'aprovado', 'criadoEm'])
        && request.resource.data.aprovado == false
        && request.resource.data.ap is string
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 40;
      allow update: if isAdmin();
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == uid);
    }

    // Veículo de cada apartamento (id do documento = apartamento, ex.: "101", "I-13")
    match /veiculos/{ap} {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin() || ownsAp(ap);
    }

    // Disponibilidade da vaga de cada apartamento (id = apartamento)
    match /disponivel/{ap} {
      allow read: if approved() || isAdmin();
      allow write: if isAdmin() || ownsAp(ap);
    }
  }
}
