rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }
    function shortStr(f, max) { return f is string && f.size() <= max; }

    // Distribuição das vagas: pública para leitura, só admin altera
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Lista de administradores: criada à mão no console do Firebase
    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Versão aberta: qualquer pessoa com o link vê e cadastra.
    // As regras só garantem o formato dos dados.

    // Veículo de cada apartamento (id do documento = apartamento, ex.: "101", "I-13")
    match /veiculos/{ap} {
      allow read: if true;
      allow delete: if ap.size() <= 6;
      allow create, update: if ap.size() <= 6
        && request.resource.data.keys().hasOnly(['placa', 'nome', 'modelo', 'cor', 'obs', 'atualizadoEm'])
        && request.resource.data.placa is string && request.resource.data.placa.matches('^[A-Z0-9]{7}$')
        && shortStr(request.resource.data.nome, 40) && request.resource.data.nome.size() > 0
        && shortStr(request.resource.data.modelo, 40)
        && shortStr(request.resource.data.cor, 20)
        && shortStr(request.resource.data.obs, 120);
    }

    // Disponibilidade da vaga de cada apartamento (id = apartamento)
    match /disponivel/{ap} {
      allow read: if true;
      allow delete: if ap.size() <= 6;
      allow create, update: if ap.size() <= 6
        && request.resource.data.keys().hasOnly(['vaga', 'de', 'ate', 'obs', 'atualizadoEm'])
        && request.resource.data.vaga is int && request.resource.data.vaga >= 1 && request.resource.data.vaga <= 200
        && request.resource.data.de is string && request.resource.data.de.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && request.resource.data.ate is string && request.resource.data.ate.matches('^\\d{4}-\\d{2}-\\d{2}$')
        && shortStr(request.resource.data.obs, 120);
    }

    // Vaga alugada: carro de outro apartamento na vaga do dono (id = "v" + número da vaga)
    match /alugueis/{id} {
      allow read: if true;
      allow delete: if id.size() <= 4;
      allow create, update: if request.resource.data.keys().hasOnly(['vaga', 'donoAp', 'usoAp', 'nome', 'placa', 'modelo', 'cor', 'obs', 'atualizadoEm'])
        && request.resource.data.vaga is int && id == 'v' + string(request.resource.data.vaga)
        && shortStr(request.resource.data.donoAp, 6) && shortStr(request.resource.data.usoAp, 6)
        && request.resource.data.donoAp != request.resource.data.usoAp
        && request.resource.data.placa is string && request.resource.data.placa.matches('^[A-Z0-9]{7}$')
        && shortStr(request.resource.data.nome, 40) && request.resource.data.nome.size() > 0
        && shortStr(request.resource.data.modelo, 40)
        && shortStr(request.resource.data.cor, 20)
        && shortStr(request.resource.data.obs, 120);
    }

    // Qualquer outra coleção fica fechada
  }
}
